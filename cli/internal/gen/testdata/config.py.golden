from __future__ import annotations

import os
from typing import Any, Literal

from pydantic import BaseModel, ConfigDict, Field, ValidationError
from pydantic_core import core_schema


class Secret(str):
    """A string that does not reveal itself in tracebacks or logs.

    repr() is what ends up in a pydantic error, a pytest diff and most
    logging calls, so redacting it there covers the realistic leak paths.
    str() still returns the real value — the point is to make leaking
    deliberate rather than accidental.
    """

    __slots__ = ()

    def __repr__(self) -> str:  # noqa: D105
        return "Secret('***')"

    @classmethod
    def __get_pydantic_core_schema__(
        cls, source_type: Any, handler: Any
    ) -> core_schema.CoreSchema:
        # A bare str subclass is not a pydantic type. Validate as a str,
        # then wrap — so coercion still works and the field stays typed.
        del source_type, handler
        return core_schema.no_info_after_validator_function(
            cls, core_schema.str_schema(min_length=1)
        )


class Env(BaseModel):
    """Validated view of this repo's environment."""

    model_config = ConfigDict(frozen=True, extra="ignore")

    BATCH_SIZE: int = Field(ge=1, le=100)
    """Items per batch."""

    DIGEST_OUTPUT: Literal["file", "s3"]
    """Where the digest goes."""

    LLM_API_KEY: Secret
    """Key for the LLM provider."""

    SITE: str
    """Public site."""

    DEBUG: bool | None = Field(default=None)
    """Verbose logging."""

    DIGEST_OUTPUT_PATH: str | None = Field(default=None)
    """Digest file."""


_NAMES = (
    "BATCH_SIZE",
    "DIGEST_OUTPUT",
    "LLM_API_KEY",
    "SITE",
    "DEBUG",
    "DIGEST_OUTPUT_PATH",
)


_PLACEHOLDERS = frozenset(
    {
        "change-me",
        "changeme",
        "replace-me",
        "replace_me",
        "tbd",
        "todo",
        "xxx",
    }
)


def _present(value: str) -> bool:
    """Is this raw environment value a real one?

    Mirrors ezc's own validator. An unset variable, an empty or
    whitespace-only one, and an unfilled placeholder are all ABSENT — not
    present-but-invalid. A workflow naming a secret that does not exist
    substitutes the empty string, and that must not read as a value.
    """
    stripped = value.strip()
    return bool(stripped) and stripped.lower() not in _PLACEHOLDERS


def load() -> Env:
    """Build Env from os.environ, or raise EnvError naming every problem.

    Collects all failures rather than stopping at the first: a fresh clone
    should get one list, not ten sequential fix-and-retry cycles.
    """
    raw = {
        name: os.environ[name].strip()
        for name in _NAMES
        if name in os.environ and _present(os.environ[name])
    }
    try:
        return Env.model_validate(raw)
    except ValidationError as exc:
        raise EnvError(_format(exc)) from None


class EnvError(RuntimeError):
    """The environment is incomplete or invalid."""


_DESCRIPTIONS = {
    "BATCH_SIZE": "Items per batch.",
    "DIGEST_OUTPUT": "Where the digest goes.",
    "LLM_API_KEY": "Key for the LLM provider.",
    "SITE": "Public site.",
    "DEBUG": "Verbose logging.",
    "DIGEST_OUTPUT_PATH": "Digest file.",
}


def _format(exc: ValidationError) -> str:
    lines = ["Env validation failed:"]
    for err in exc.errors():
        name = str(err["loc"][0]) if err["loc"] else "?"
        desc = _DESCRIPTIONS.get(name, "")
        # Never interpolate err['input']: for a secret that would print
        # the value into the exception message.
        lines.append(f"  {name} — {desc}" if desc else f"  {name}")
        lines.append(f"      {err['msg']}")
    return "\n".join(lines)
