# Puts bin/ on PATH: bin/ezc builds cli/ on first use and whenever it changes,
# so `direnv allow` is the whole setup for working on ezc.
PATH_add bin

# The local commit-push gate: lefthook.yml. mise install brings lefthook in
# (mise.toml pins it) and lefthook install writes the hooks into .git/hooks.
mise install
lefthook install
