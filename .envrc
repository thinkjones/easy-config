# Puts bin/ on PATH: bin/ezc is the shim that builds cli/ on first use and
# whenever it changes, so `ezc` works in any shell after `direnv allow`.
PATH_add bin

# mise install brings lefthook in (mise.toml pins it) and runs
# scripts/install-hooks.sh, which writes the local gate into the hooks git
# runs. Nothing else is needed to be guarded.
mise install
